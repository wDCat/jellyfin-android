<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/video_proxy_volume_background"
    android:clipToOutline="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/video_proxy_volume_dialog_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pref_video_proxy_volume_title"
            android:textColor="@color/video_buffering_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pref_video_proxy_volume_summary"
            android:textColor="@color/video_proxy_volume_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/volume_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/jellyfin_accent"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/volume_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/video_proxy_volume_secondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/volume_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/pref_video_proxy_volume_title"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/volume_min"
                style="@style/VideoProxyVolumeScale"
                android:gravity="start" />

            <TextView
                android:id="@+id/volume_normal"
                style="@style/VideoProxyVolumeScale"
                android:gravity="center" />

            <TextView
                android:id="@+id/volume_max"
                style="@style/VideoProxyVolumeScale"
                android:gravity="end" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/done"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/pref_video_proxy_volume_done"
            android:textColor="@color/jellyfin_accent" />
    </LinearLayout>
</ScrollView>
