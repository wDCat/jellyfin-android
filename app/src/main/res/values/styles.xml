<resources>
    <!-- Application theme -->
    <style name="AppTheme.V21" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/jellyfin_primary</item>
        <item name="colorPrimaryDark">@color/jellyfin_primary_dark</item>
        <item name="colorAccent">@color/jellyfin_accent</item>
        <item name="android:windowBackground">@color/theme_background</item>
        <item name="android:navigationBarColor">@color/theme_background</item>
    </style>

    <style name="AppTheme" parent="AppTheme.V21" />

    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/theme_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Settings theme -->
    <style name="AppTheme.Settings" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/settings_primary</item>
        <item name="colorOnPrimary">@color/settings_on_primary</item>
        <item name="colorPrimaryContainer">@color/settings_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/settings_on_primary_container</item>
        <item name="colorSecondary">@color/settings_secondary</item>
        <item name="colorOnSecondary">@color/settings_on_secondary</item>
        <item name="colorSecondaryContainer">@color/settings_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/settings_on_secondary_container</item>
        <item name="colorSurface">@color/settings_surface</item>
        <item name="colorSurfaceContainerLow">@color/settings_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/settings_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/settings_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/settings_surface_container_highest</item>
        <item name="colorOnSurface">@color/settings_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/settings_on_surface_variant</item>
        <item name="colorOutline">@color/settings_outline</item>
        <item name="colorOutlineVariant">@color/settings_outline_variant</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
    </style>

    <!-- Theme Overlays -->
    <style name="ThemeOverlay.App.BackButton" parent="">
        <item name="colorControlNormal">?android:textColorPrimary</item>
    </style>
    <style name="VideoProxyVolumeScale" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/video_proxy_volume_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

</resources>
